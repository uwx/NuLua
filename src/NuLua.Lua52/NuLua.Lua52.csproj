<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0;netstandard2.1</TargetFrameworks>
    <LangVersion>14</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <CodeGenName>Lua52</CodeGenName>
    <CodeGenVersion>502</CodeGenVersion>
    <CodeGenProject>$(MSBuildThisFileDirectory)..\..\tools\CodeGen\CodeGen.csproj</CodeGenProject>
    <CodeGenTemplateDir>$(MSBuildThisFileDirectory)..\..\tools\CodeGen\Templates</CodeGenTemplateDir>
    <CodeGenOutputDir>$(MSBuildThisFileDirectory)Generated</CodeGenOutputDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.1.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\NuLua.Shared\NuLua.Shared.csproj" />
    <ProjectReference Include="..\NuLua.Runtime.Lua52\NuLua.Runtime.Lua52.csproj" />
    <ProjectReference Include="..\NuLua.Interop.Lua52\NuLua.Interop.Lua52.csproj" />
  </ItemGroup>
  <ItemGroup>
    <CodeGenTemplate Include="$(CodeGenTemplateDir)\*.scriban-cs" />
  </ItemGroup>
  <Target Name="BuildCodeGen" BeforeTargets="RunCodeGen">
    <MSBuild Projects="$(CodeGenProject)"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=net10.0"
             RemoveProperties="TargetFramework" />
  </Target>
  <Target Name="RunCodeGen"
          BeforeTargets="CoreCompile"
          Inputs="@(CodeGenTemplate)"
          Outputs="$(CodeGenOutputDir)\$(CodeGenName)State.g.cs;$(CodeGenOutputDir)\$(CodeGenName)AsyncDriver.g.cs">
    <MakeDir Directories="$(CodeGenOutputDir)" />
    <Exec Command="dotnet run --project &quot;$(CodeGenProject)&quot; --no-build -- --name $(CodeGenName) --version $(CodeGenVersion) --template-dir &quot;$(CodeGenTemplateDir)&quot; --output-dir &quot;$(CodeGenOutputDir)&quot;" />
  </Target>
  <Target Name="IncludeCodeGenOutput"
          BeforeTargets="CoreCompile"
          DependsOnTargets="RunCodeGen">
    <ItemGroup>
      <Compile Include="$(CodeGenOutputDir)\*.g.cs" Exclude="@(Compile)" />
    </ItemGroup>
  </Target>
</Project>
