<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Not include this dll, only native dlls. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <Description>luajit native runtimes for NuLua.Interop.LuaJit.</Description>

    <!-- NuGet -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="runtimes\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="NuLua.Runtime.LuaJit.win-x64.csproj" />
    <ProjectReference Include="NuLua.Runtime.LuaJit.win-arm64.csproj" />
    <ProjectReference Include="NuLua.Runtime.LuaJit.linux-x64.csproj" />
    <ProjectReference Include="NuLua.Runtime.LuaJit.linux-arm64.csproj" />
    <ProjectReference Include="NuLua.Runtime.LuaJit.osx-x64.csproj" />
    <ProjectReference Include="NuLua.Runtime.LuaJit.osx-arm64.csproj" />
  </ItemGroup>

</Project>
