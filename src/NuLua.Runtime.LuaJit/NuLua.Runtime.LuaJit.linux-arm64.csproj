<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Not include this dll, only native dlls. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <Description>luajit native runtime for linux-arm64.</Description>

    <!-- NuGet Packaging -->
    <IsPackable>true</IsPackable>
    <PackageTags>lua;luau;luajit</PackageTags>
    <Description>NuLua Runtime for LuaJIT Linux ARM64</Description>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="README.md" />
    <None Include="..\..\assets\icon.png" Pack="true" PackagePath="icon.png" />
    <EmbeddedResource Include="..\..\LICENSE" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="runtimes\**" />
    <None
      Include="runtimes\linux-arm64\native\libluajit.so"
      PackagePath="runtimes\linux-arm64\native\"
      Pack="true"
    >
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
