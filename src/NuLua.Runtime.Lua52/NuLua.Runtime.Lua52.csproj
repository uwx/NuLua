<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- Not include this dll, only native dlls. -->
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeContentInPack>true</IncludeContentInPack>
    <NoWarn>$(NoWarn);NU5100;NU5128</NoWarn>
    <Description>lua52 native runtimes for NuLua.Interop.Lua52.</Description>

    <!-- NuGet -->
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="runtimes\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="NuLua.Runtime.Lua52.win-x64.csproj" />
    <ProjectReference Include="NuLua.Runtime.Lua52.win-arm64.csproj" />
    <ProjectReference Include="NuLua.Runtime.Lua52.linux-x64.csproj" />
    <ProjectReference Include="NuLua.Runtime.Lua52.linux-arm64.csproj" />
    <ProjectReference Include="NuLua.Runtime.Lua52.osx-x64.csproj" />
    <ProjectReference Include="NuLua.Runtime.Lua52.osx-arm64.csproj" />
  </ItemGroup>
</Project>
