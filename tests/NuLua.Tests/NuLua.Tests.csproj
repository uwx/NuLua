<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="TUnit" Version="1.5*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NuLua.Lua51\NuLua.Lua51.csproj" />
    <ProjectReference Include="..\..\src\NuLua.Lua52\NuLua.Lua52.csproj" />
    <ProjectReference Include="..\..\src\NuLua.Lua53\NuLua.Lua53.csproj" />
    <ProjectReference Include="..\..\src\NuLua.Lua54\NuLua.Lua54.csproj" />
    <ProjectReference Include="..\..\src\NuLua.Lua55\NuLua.Lua55.csproj" />
    <ProjectReference Include="..\..\src\NuLua.LuaJit\NuLua.LuaJit.csproj" />
    <ProjectReference Include="..\..\src\NuLua.Luau\NuLua.Luau.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-arm64'">
    <None Include="..\..\src\NuLua.Runtime.*\runtimes\osx-arm64\native\*.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'osx-x64'">
    <None Include="..\..\src\NuLua.Runtime.*\runtimes\osx-x64\native\*.dylib">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-arm64'">
    <None Include="..\..\src\NuLua.Runtime.*\runtimes\linux-arm64\native\*.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'linux-x64'">
    <None Include="..\..\src\NuLua.Runtime.*\runtimes\linux-x64\native\*.so">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-arm64'">
    <None Include="..\..\src\NuLua.Runtime.*\runtimes\win-arm64\native\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup Condition="'$(NETCoreSdkRuntimeIdentifier)' == 'win-x64'">
    <None Include="..\..\src\NuLua.Runtime.*\runtimes\win-x64\native\*.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
  </ItemGroup>
</Project>
